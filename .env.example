# Copy to .env for local overrides. These are safe defaults; no secrets are required.
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db).
SENTINELGUARD_DATABASE_URL=sqlite:///./data/sentinelguard.db

# Upload limits
SENTINELGUARD_MAX_UPLOAD_BYTES=1048576
SENTINELGUARD_MAX_FILES_PER_SCAN=10

# Logging: json | text
SENTINELGUARD_LOG_LEVEL=INFO
SENTINELGUARD_LOG_FORMAT=json

# Where the Streamlit dashboard finds the API
SENTINELGUARD_API_BASE_URL=http://localhost:8000
